[Unit]
Description=SIMPEL-RS Laravel scheduler tick
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=nialapps
Group=nialapps
WorkingDirectory=/var/www/apps/simpel-rs
ExecStart=/usr/bin/php artisan schedule:run --no-interaction
PrivateTmp=true
NoNewPrivileges=true
