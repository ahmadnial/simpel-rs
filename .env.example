APP_NAME="SIMPEL-RS"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://simpel.rsnurrohmah.my.id

APP_KEY=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=sivera
DB_USERNAME=simpel_rs_app
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=true

SESSION_DRIVER=database
# Delapan jam untuk satu hari kerja; halaman formulir/editor juga memperbarui
# sesi secara periodik selama browser tetap terbuka.
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

KODE_RS=RSNR
LIBREOFFICE_PATH=/usr/bin/soffice
ONLYOFFICE_URL=http://localhost:8080
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_ALLOWED_HOSTS=localhost

# Diisi melalui secret manager/runtime injection. Harus berbeda dan minimal 32 byte.
TTE_OTP_HMAC_SECRET=
TTE_OTP_DESTINATION_HMAC_SECRET=
# Gunakan `display` hanya untuk local/testing; produksi wajib `email`.
TTE_OTP_DELIVERY=email
TTE_SECURITY_LOG_CHANNEL=stack
TTE_SIGNER_PROVIDER=unavailable
TTE_IMMUTABLE_STORE_PROVIDER=unavailable
OPENBAO_ADDR=http://127.0.0.1:8200
OPENBAO_TOKEN=
OPENBAO_TRANSIT_KEY=simpel-rs-evidence
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=simpel-rs-evidence
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
